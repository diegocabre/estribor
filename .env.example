# Copiar como .env.local y completar. Nunca subir .env.local a git.
# Las variables NEXT_PUBLIC_* llegan al navegador: no pongas secretos en ellas.

# --- Correo (Resend) · solo servidor ---
RESEND_API_KEY=
# Remitente con dominio verificado en Resend, p. ej. "Estribor Consultores <contacto@estriborconsultores.cl>"
RESEND_FROM_EMAIL=
NOTIFICATION_RECIPIENT_EMAIL=contacto@estriborconsultores.cl

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: ignora RLS. SOLO servidor (rutas /api). Supabase > Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel de vacantes · solo servidor ---
# Respaldo del rol si el usuario aún no tiene app_metadata.role (correos separados por coma).
ADMIN_EMAILS=
RECRUITER_EMAILS=

# --- Cron de Vercel · solo servidor ---
# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>" a /api/cron/keepalive.
# Generar con: openssl rand -hex 32
CRON_SECRET=

# --- Analítica y SEO ---
NEXT_PUBLIC_SITE_URL=https://www.estriborconsultores.cl
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
